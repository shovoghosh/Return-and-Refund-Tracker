generator client {
  // Classic generator with the default output (node_modules/.prisma/client).
  // OpenNext copies Prisma's `workerd` build into the Worker bundle only for
  // packages generated there, and Next traces it as an external package
  // (serverExternalPackages in next.config.ts).
  provider = "prisma-client-js"
}

datasource db {
  // Cloudflare D1 is SQLite. SQLite has no native enum or date column types, so
  // status values are strings (validated in src/lib/status.ts) and calendar
  // dates are stored as DateTime at UTC midnight; the app's date helpers treat
  // them as calendar dates, exactly as before.
  provider = "sqlite"
  // Only the Prisma CLI uses this (generate / migrate diff). The running app
  // gets its database from the Cloudflare D1 binding, never from this URL.
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  emailVerifiedAt  DateTime?
  timezone         String    @default("America/Edmonton")
  reminderOffsets  String    @default("[7,2,1]")
  reminderHour     Int       @default(9)
  emailRemindersOn Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  orders             Order[]
  items              Item[]
  returns            Return[]
  attachments        Attachment[]
  events             Event[]
  reminderDeliveries ReminderDelivery[]
  sessions           Session[]
  verifyTokens       VerifyToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerifyToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id           String   @id @default(cuid())
  userId       String
  storeName    String
  orderNumber  String?
  purchaseDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        Item[]

  @@index([userId])
}

model Item {
  id             String    @id @default(cuid())
  userId         String
  orderId        String
  name           String
  amountCents    Int?
  currency       String?
  itemUrl        String?
  returnDeadline DateTime
  status         String    @default("OPEN")
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  return         Return?
  attachments    Attachment[]
  events         Event[]
  reminderDeliveries ReminderDelivery[]

  @@index([userId, status])
  @@index([userId, returnDeadline])
}

model Return {
  id                  String    @id @default(cuid())
  itemId              String    @unique
  userId              String
  returnStartedAt     DateTime?
  returnedAt          DateTime?
  carrier             String?
  trackingNumber      String?
  expectedRefundCents Int?
  expectedRefundDate  DateTime?
  actualRefundCents   Int?
  actualRefundDate    DateTime?
  refundReceivedAt    DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  item                Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attachment {
  id               String   @id @default(cuid())
  userId           String
  itemId           String
  storageKey       String   @unique
  originalFilename String
  contentType      String
  sizeBytes        Int
  kind             String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

model Event {
  id        String   @id @default(cuid())
  userId    String
  itemId    String?
  eventType String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model ReminderDelivery {
  id                String    @id @default(cuid())
  userId            String
  itemId            String
  reminderType      String
  scheduledFor      DateTime
  sentAt            DateTime?
  providerMessageId String?
  status            String    @default("PENDING")
  attemptCount      Int       @default(0)
  lastError         String?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item              Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, reminderType, scheduledFor])
  @@index([status, scheduledFor])
}
